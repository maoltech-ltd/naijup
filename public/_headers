# Applied by Cloudflare Workers static assets (these files never reach the
# Next.js server, so next.config.mjs headers() doesn't cover them).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/image/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/icon.svg
  Cache-Control: public, max-age=2592000
